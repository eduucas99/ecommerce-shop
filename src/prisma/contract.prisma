// use prisma-8

enum Gender {
  men
  women
  kid
  unisex
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
  XXXL
}

enum Role {
  admin
  user
}


model Category {
  id      String    @id @default(uuid())
  name    String    @unique
  Product Product[]
}

model Product {
  id          String        @id @default(uuid())
  title       String
  description String?
  inStock     Int
  price       Float         @default(0)
  slug        String        @unique
  sizes       Size[]        
  tags        String[]      @default([])
  gender      Gender
  
  //Relaciones
  category    Category      @relation(fields: [categoryId], references: [id])
  categoryId  String
  ProductImage ProductImage[]

  @@index([gender])
}

model ProductImage {
  id          Int          @id @default(autoincrement())
  url         String

  product     Product      @relation(fields: [productId], references: [id])
  productId   String
}

model User {
  id          String        @id @default(uuid())
  name        String
  email       String        @unique
  emailVerified DateTime?
  password    String
  role        Role          @default(user)
  images      String?
  createdAt   DateTime      @default(now())
  updatedAt   Timestamp     @default(now())


}